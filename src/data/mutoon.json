            },
            {
              "n": 3,
              "sadr": "(محمدٍ) وآله وصحبه",
              "ajuz": "ومقرئ القرآن مع محبه"
            },
            {
              "n": 4,
              "sadr": "(وبعد) إن هذه مقدِّمه",
              "ajuz": "فيما على قارئه أن يعلمَه"
            },
            {
              "n": 5,
              "sadr": "إذ واجبٌ عليهمُ محتمُ",
              "ajuz": "قبل الشروع أولاً أن يعلمُوا"
            },
            {
              "n": 6,
