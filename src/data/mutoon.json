  "texts": {
    "tuhfa": {
      "url": "https://www.alukah.net/sharia/0/57837/",
      "title": "متن تحفة الأطفال",
      "author": "سليمان بن حسين الجمزوري",
      "sections": [
        {
          "heading": "مقدمة",
          "lines": [
            {
              "n": 1,
              "sadr": "يقول راجي رحمةِ الغفور",
              "ajuz": "دومًا سليمان هو الجَمْزُورِي"
            },
            {
              "n": 2,
              "sadr": "الحمد لله مصليًا على",
              "ajuz": "محمد وآله ومَن تلا"
            },
            {
              "n": 3,
              "sadr": "وبعدُ هذا النظم للمريد",
              "ajuz": "في النون والتنوين والمدود"
            },
            {
              "n": 4,
              "sadr": "سميتُه بتحفة الأطفال",
              "ajuz": "عن شيخنا المَيْهِي ذي الكمال"
            },
            {
              "n": 5,
              "sadr": "أرجو به أن ينفع الطلابا",
              "ajuz": "والأجر والقبول والثوابا"
            }
          ]
        },
        {
          "heading": "أحكام النون الساكنة والتنوين",
          "lines": [
            {
              "n": 6,
              "sadr": "للنون إن تسكنْ وللتنوين",
              "ajuz": "أربعُ أحكام فخُذْ تبييني"
            },
            {
              "n": 7,
              "sadr": "فالأول الإظهار قبل أحرفِ",
              "ajuz": "للحلق ستُّ رتِّبت فلتعرف"
            },
            {
              "n": 8,
              "sadr": "همزٌ فهاءٌ ثم عين حاء",
              "ajuz": "مهملتان ثم غين خاء"
            },
            {
              "n": 9,
              "sadr": "والثاني إدغامٌ بستة أتت",
              "ajuz": "في يَرْمُلُون عندهم قد ثبتت"
            },
            {
              "n": 10,
              "sadr": "لكنها قسمان قسم يدغما",
              "ajuz": "فيه بغنة بينمو عُلِما"
            },
            {
              "n": 11,
              "sadr": "إلا إذا كان بكلْمةٍ فلا",
              "ajuz": "تدغم كدنيا ثم صنوان تلا"
            },
            {
              "n": 12,
              "sadr": "والثاني إدغام بغير غنَّه",
              "ajuz": "في اللام والرا ثم كرِّرنه"
            },
            {
              "n": 13,
              "sadr": "والثالث الإقلاب عند الباء",
              "ajuz": "ميمًا بغنة مع الإخفاء"
            },
            {
              "n": 14,
              "sadr": "والرابع الإخفاء عند الفاضل",
              "ajuz": "من الحروف واجب للفاضل"
            },
            {
              "n": 15,
              "sadr": "في خمسةٍ من بعد عشر رمزُها",
              "ajuz": "في كلم هذا البيت قد ضمَّنتها"
            },
            {
              "n": 16,
              "sadr": "صِفْ ذا ثَنَا كم جَادَ شخصٌ قد سما",
              "ajuz": "دُمْ طيبًا زِدْ في تقى ضَعْ ظالمًا"
            }
          ]
        },
        {
          "heading": "أحكام النون والميم المشدَّدتين",
          "lines": [
            {
              "n": 17,
              "sadr": "وغنَّ ميمًا ثم نونًا شدِّدا",
              "ajuz": "وسمِّ كلاًّ حرف غنة بدا"
            }
          ]
        },
        {
          "heading": "أحكام الميم الساكنة",
          "lines": [
            {
              "n": 18,
              "sadr": "والميم إن تسكن تَجِي قبل الهجا",
              "ajuz": "لا ألف لينةٍ لذي الحجا"
            },
            {
              "n": 19,
              "sadr": "أحكامها ثلاثةٌ لمن ضبط",
              "ajuz": "إخفاء ادغام وإظهار فقط"
            },
            {
              "n": 20,
              "sadr": "فالأول الإخفاء عند الباء",
              "ajuz": "وسمِّه الشفْوي للقراء"
            },
            {
              "n": 21,
              "sadr": "والثاني إدغام بمثلها أتى",
              "ajuz": "وسمِّ إدغامًا صغيرًا يا فتى"
            },
            {
              "n": 22,
              "sadr": "والثالث الإظهار في البقيه",
              "ajuz": "من أحرف وسمِّها شفويه"
            },
            {
              "n": 23,
              "sadr": "واحذر لدى واوٍ وفا أن تختفي",
              "ajuz": "لقربها ولاتحاد فاعرفِ"
            }
          ]
        },
        {
          "heading": "حكم لام أل ولام الفعل",
          "lines": [
            {
              "n": 24,
              "sadr": "للام أل حالان قبل الأحرف",
              "ajuz": "أولاهما إظهارها فلتعرف"
            },
            {
              "n": 25,
              "sadr": "قبل اربعٍ مع عشْرةٍ خذ علمَه",
              "ajuz": "من ابغ حجَّك وخفْ عقيمَه"
            },
            {
              "n": 26,
              "sadr": "ثانيهما إدغامها في أربعٍ",
              "ajuz": "وعشرةٍ أيضًا ورمزها فَعِ"
            },
            {
              "n": 27,
              "sadr": "طِبْ ثم صِلْ رحمًا تَفُزْ ضِفْ ذا نِعَم",
              "ajuz": "دَعْ سُوءَ ظنِّ زُرْ شريفًا للكرم"
            },
            {
              "n": 28,
              "sadr": "واللام الاولى سمِّها قَمْريه",
              "ajuz": "واللام الاخرى سمِّها شَمْسيه"
            },
            {
              "n": 29,
              "sadr": "وأَظهِرنَّ لام فعلٍ مطلقا",
              "ajuz": "في نحو: قُلْ نَعَم، وقُلْنا وَالْتَقى"
            }
          ]
        },
        {
          "heading": "في المثلين والمتقاربين والمتجانسين",
          "lines": [
            {
              "n": 30,
              "sadr": "إنْ في الصفات والمخارج اتَّفق",
              "ajuz": "حرفانِ فالمثلان فيهما أحق"
            },
            {
              "n": 31,
              "sadr": "وإن يكونا مخرجًا تقاربًا",
              "ajuz": "وفي الصفات اختلفا يلقَّبا"
            },
            {
              "n": 32,
              "sadr": "متْقاربين أو يكونا اتفقا",
              "ajuz": "في مخرجٍ دون الصفات حقِّقا"
            },
            {
              "n": 33,
              "sadr": "بالمتجانسين، ثم إن سكن",
              "ajuz": "أولُ كلٍ فالصغير سَمِّيَن"
            },
            {
              "n": 34,
              "sadr": "أو حرِّك الحرفان في كلٍّ فقل",
              "ajuz": "كلٌّ كبير وَافْهَمَنه بالمثل"
            }
          ]
        },
        {
          "heading": "أقسام المد",
          "lines": [
            {
              "n": 35,
              "sadr": "والمد أصلي وفرعي له",
              "ajuz": "وسمِّ أولاً طبيعيًّا وهُو"
            },
            {
              "n": 36,
              "sadr": "ما لا توقفٌ له على سبب",
              "ajuz": "ولا بدونه الحروف تجتلب"
            },
            {
              "n": 37,
              "sadr": "بل أي حرف غير همزٍ أو سكون",
              "ajuz": "جا بعد مد فالطبيعيَّ يكون"
            },
            {
              "n": 38,
              "sadr": "والآخر الفرعي موقوفٌ على",
              "ajuz": "سببْ كهمزٍ أو سكون مسجلا"
            },
            {
              "n": 39,
              "sadr": "حروفه ثلاثة فَعِيها",
              "ajuz": "من لفظ واي وهي في نوحيها"
            },
            {
              "n": 40,
              "sadr": "والكسر قبل اليا وقبل الواو ضم",
              "ajuz": "شرط وفتح قبل ألْفٍ يلتزم"
            },
            {
              "n": 41,
              "sadr": "واللين منها اليا وواو سكنا",
              "ajuz": "إن انفتاح قبل كلٍّ أعلنا"
            }
          ]
        },
        {
          "heading": "أحكام المد",
          "lines": [
            {
              "n": 42,
              "sadr": "للمد أحكام ثلاثة تدوم",
              "ajuz": "وهي الوجوب والجواز واللزوم"
            },
            {
              "n": 43,
              "sadr": "فواجب إن جاء همز بعد مد",
              "ajuz": "في كلْمة وذا بمتصْل يعد"
            },
            {
              "n": 44,
              "sadr": "وجائز مد وقصر إن فُصِل",
              "ajuz": "كل بكلمة وهذا المنفصِل"
            },
            {
              "n": 45,
              "sadr": "ومثل ذا إن عَرَض السكونُ",
              "ajuz": "وقفًا كتعلمون نستعينُ"
            },
            {
              "n": 46,
              "sadr": "أو قدِّم الهمز على المد وذا",
              "ajuz": "بدلْ كآمنوا وإيمانًا خذا"
            },
            {
              "n": 47,
              "sadr": "ولازمٌ إنِ السكونُ أصِّلا",
              "ajuz": "وصلاً ووقفًا بعد مد طوِّلا"
            }
          ]
        },
        {
          "heading": "أقسام المد اللازم",
          "lines": [
            {
              "n": 48,
              "sadr": "أقسام لازم لديهم أربعه",
              "ajuz": "وتلك كلْمي وحرفي معه"
            },
            {
              "n": 49,
              "sadr": "كلاهما مخفَّف مثقَّل",
              "ajuz": "فهذه أربعة تفصَّل"
            },
            {
              "n": 50,
              "sadr": "فإنْ بكلْمة سكونٌ اجتمع",
              "ajuz": "مع حرف مد فهو كلْمي وقع"
            },
            {
              "n": 51,
              "sadr": "أو في ثلاثيِّ الحروف وجدا",
              "ajuz": "والمد وسْطه فحرفي بدا"
            },
            {
              "n": 52,
              "sadr": "كلاهما مثقَّل إن أدغما",
              "ajuz": "مخفَّف كلٌّ إذا لم يدغما"
            },
            {
              "n": 53,
              "sadr": "واللازم الحرفي أول السور",
              "ajuz": "وجوده وفي ثمان انحصر"
            },
            {
              "n": 54,
              "sadr": "يجمعها حروف كم عسل نقص",
              "ajuz": "وعين ذو وجهين والطول أخص"
            },
            {
              "n": 55,
              "sadr": "وما سوى الحرف الثلاثي لا ألف",
              "ajuz": "فمده مدًّا طبيعيًّا أُلِف"
            },
            {
              "n": 56,
              "sadr": "وذاك أيضًا في فواتح السور",
              "ajuz": "في لفظ حي طاهر قد انحصر"
            },
            {
              "n": 57,
              "sadr": "ويجمع الفواتح الأربعْ عَشر",
              "ajuz": "صِلْه سُحيرًا مَن قَطَعْكَ ذا اشتهر"
            }
          ]
        },
        {
          "heading": "خاتمة",
          "lines": [
            {
              "n": 58,
              "sadr": "وتم ذا النظم بحمد الله",
              "ajuz": "على تمامه بلا تناهي"
            },
            {
              "n": 59,
              "sadr": "أبياته ندٌّ بدا لذ النهى",
              "ajuz": "تاريخها بشرى لمن يتقنها"
            },
            {
              "n": 60,
              "sadr": "ثم الصلاة والسلام أبدا",
              "ajuz": "على ختام الأنبياء أحمدا"
            },
            {
              "n": 61,
              "sadr": "والآل والصحب وكل تابع",
              "ajuz": "وكل قارئ وكل سامع"
            }
          ]
        }
      ]
    },
    "jazariyya": {
