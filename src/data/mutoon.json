        {
          "heading": "باب التحذيرات",
          "lines": [
            {
              "n": 60,
              "sadr": "وإن تلاقيا البيان لازمُ",
              "ajuz": "أَنْقَضَ ظهرَك يَعَضُّ الظالمُ"
            },
            {
              "n": 61,
              "sadr": "واضطرَّ معْ وَعَظْتَ معْ أَفَضْتُم",
              "ajuz": "وصف ها جباههم عليهم"
            }
