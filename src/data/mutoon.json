            {
              "n": 96,
              "sadr": "لقمان ثم فاطر كالطور",
              "ajuz": "عمران لعنت بها والنور"
            },
            {
              "n": 97,
              "sadr": "وامرأت يوسف عمران القصص",
              "ajuz": "تحريم معصيت بقد سمع يخص"
            },
            {
              "n": 98,
              "sadr": "شجرت الدخان سنت فاطر",
              "ajuz": "كلاًّ والانفال وحرف غافر"
            },
            {
              "n": 99,
              "sadr": "قرت عين جنت في وقعت",
              "ajuz": "فطرت بقيت وابنت وكلمت"
            },
            {
              "n": 100,
              "sadr": "أوسط الاعراف وكل ما اختلف",
              "ajuz": "جمعًا وفردًا فيه بالتاء عرف"
            }
          ]
        },
        {
          "heading": "باب همز الوصل",
          "lines": [
