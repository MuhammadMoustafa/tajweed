        },
        {
          "heading": "باب حكم التنوين والنون الساكنة",
          "lines": [
            {
              "n": 65,
              "sadr": "وحكم تنوين ونون يُلفَى",
              "ajuz": "إظهارٌ ادغامٌ وقلبٌ اخفا"
