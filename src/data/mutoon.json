            {
              "n": 58,
              "sadr": "إلا بويل هل وأُولَى ناضره",
              "ajuz": "والغيظ لا الرعد وهود قاصره"
            },
            {
              "n": 59,
              "sadr": "والحظ لا الحضُّ على الطعامِ",
              "ajuz": "وفي ضنينٍ الخلاف سامي"
            }
          ]
