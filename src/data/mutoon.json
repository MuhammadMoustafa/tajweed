            {
              "n": 108,
              "sadr": "على النبي المصطفى وآلِه",
              "ajuz": "وصحبه وتابعي منوالِه"
            },
            {
              "n": 109,
              "sadr": "أبياتها قافٌ وزايٌ في العدد",
              "ajuz": "مَن يُحسِن التجويد يَظفَر بالرشد"
            }
          ]
        }
