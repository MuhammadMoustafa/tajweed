        {
          "heading": "باب المقطوع والموصول وحكم التاء",
          "lines": [
            {
              "n": 79,
              "sadr": "واعرف لمقطوعٍ وموصولٍ وتا",
              "ajuz": "في مصحف الإمام فيما قد أتى"
