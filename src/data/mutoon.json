            {
              "n": 63,
              "sadr": "الميم إن تسكن بغنة لدى",
              "ajuz": "باء على المختار من أهل الأدا"
            },
            {
              "n": 64,
              "sadr": "وأظهِرنْها عند باقي الأحرف",
              "ajuz": "واحذر لدى واو وفا أن تختفي"
            }
