            },
            {
              "n": 8,
              "sadr": "من كل مقطوع وموصول بها",
              "ajuz": "وتاء أنثى لم تكن تكتب بها"
            }
          ]
        },
        {
          "heading": "باب مخارج الحروف",
          "lines": [
            {
              "n": 9,
              "sadr": "مخارج الحروف سبعةَ عشر",
              "ajuz": "على الذي يختاره من اختبر"
            },
            {
              "n": 10,
              "sadr": "فألف الجوف وأختاها وهِيْ",
              "ajuz": "حروفُ مد للهواء تنتهِي"
            },
            {
              "n": 11,
              "sadr": "ثم لأقصى الحلق همزٌ هاءُ",
              "ajuz": "ثم لوسْطه فعينٌ حاءُ"
            },
            {
              "n": 12,
              "sadr": "أدناه غينٌ خاؤها والقافُ",
              "ajuz": "أقصى اللسانِ فوق ثم الكافُ"
            },
            {
              "n": 13,
              "sadr": "أسفل والوسط فجيمُ الشين يا",
              "ajuz": "والضاد من حافته إذ وَلِيَا"
            },
            {
              "n": 14,
              "sadr": "لاضراسَ من أيسرَ أو يمناها",
              "ajuz": "واللام أدناها لمنتهاها"
            },
            {
              "n": 15,
              "sadr": "والنون من طرفه تحت اجعلوا",
              "ajuz": "والرا يدانيه لظهر أدخلوا"
            },
            {
              "n": 16,
              "sadr": "والطاء والدال وتا منه ومِن",
              "ajuz": "عليا الثنايا والصفير مستكِن"
            },
            {
              "n": 17,
              "sadr": "منه ومن فوق الثنايا السفلى",
              "ajuz": "والظاء والذال وثا للعليا"
            },
            {
              "n": 18,
              "sadr": "من طرفيهما ومن بطن الشفه",
              "ajuz": "فالفا مع اطراف الثنايا المشرفه"
            },
            {
              "n": 19,
              "sadr": "للشفتين الواو باء ميم",
              "ajuz": "وغنَّة مخرجها الخيشوم"
            }
          ]
        },
        {
          "heading": "باب الصفات",
          "lines": [
            {
              "n": 20,
              "sadr": "صفاتها جهرٌ ورخو مستفِل",
              "ajuz": "منفتح مصمتة والضد قُل"
            },
            {
              "n": 21,
              "sadr": "مهموسها (فحثَّه شخصٌ سَكَت)",
              "ajuz": "شديدها لفظ: (أجد قط بكت)"
            },
            {
              "n": 22,
              "sadr": "وبين رخو والشديد (لِنْ عُمَر)",
              "ajuz": "وسبع علو (خُصَّ ضَغْط قظ) حصر"
            },
            {
              "n": 23,
              "sadr": "وصاد ضاد طاء ظاء مطبقه",
              "ajuz": "و (فِرَّ من لُبِّ) الحروف المذلقه"
            },
            {
              "n": 24,
              "sadr": "صفيرها صاد وزاي سين",
              "ajuz": "قلقلة (قطب جد) واللين"
            },
            {
              "n": 25,
              "sadr": "واو وياء سكنا وانفتحا",
              "ajuz": "قبلهما والانحراف صححا"
            },
            {
              "n": 26,
              "sadr": "في اللام والرا وبتكرير جعل",
              "ajuz": "وللتفشي الشين ضادًا استطل"
            }
          ]
        },
        {
          "heading": "باب التجويد",
          "lines": [
            {
              "n": 27,
              "sadr": "والأخذ بالتجويد حتمٌ لازمُ",
              "ajuz": "من لم يجوِّد القرآن آثم"
            },
            {
              "n": 28,
              "sadr": "لأنه به الإله أنزلا",
              "ajuz": "وهكذا منه إلينا وصلا"
            },
            {
              "n": 29,
              "sadr": "وهو أيضًا حلية التلاوة",
              "ajuz": "وزينة الأداء والقراءة"
            },
            {
              "n": 30,
              "sadr": "وهو إعطاء الحروف حقها",
              "ajuz": "من صفة لها ومستحقها"
            },
            {
              "n": 31,
              "sadr": "ورد كل واحد لأصله",
              "ajuz": "واللفظ في نظيره كمثله"
            },
            {
              "n": 32,
              "sadr": "مكملاً من غير ما تكلف",
              "ajuz": "باللطف في النطق بلا تعسف"
            },
            {
              "n": 33,
              "sadr": "وليس بينه وبين تركه",
              "ajuz": "إلا رياضة امرئ بفكه"
            }
          ]
        },
        {
          "heading": "باب التفخيم والترقيق",
          "lines": [
            {
              "n": 34,
              "sadr": "فرقِّقن مستفلاً من أحرف",
              "ajuz": "وحاذِرن تفخيمَ لفظ الألف"
            },
            {
              "n": 35,
              "sadr": "كهمز ألحمد أعوذ إهدنا",
              "ajuz": "ألله ثم لام لله لنا"
            },
            {
              "n": 36,
              "sadr": "وليتلطَّف وعلى اللهِ ولا الضْ",
              "ajuz": "والميم من مَخْمَصة ومن مَرَضْ"
            },
            {
              "n": 37,
              "sadr": "وباء برق باطل بهم بذي",
              "ajuz": "واحرص على الشدة والجهر الذي"
            },
            {
              "n": 38,
              "sadr": "فيها وفي الجيم كحب الصبر",
              "ajuz": "وربوة اجتثَّت وحج الفجر"
            },
            {
              "n": 39,
              "sadr": "وبينَّن مقلقلاً إن سكنا",
              "ajuz": "وإن يكن في الوقف كان أبينا"
            },
            {
              "n": 40,
              "sadr": "وحاء حصحص أَحَطْتُ الحقُّ",
              "ajuz": "وسين مستقيم يسطو يسقو"
            }
          ]
        },
        {
          "heading": "باب الراءات",
          "lines": [
            {
              "n": 41,
              "sadr": "ورقِّق الراء إذا ما كسرت",
              "ajuz": "كذاك بعد الكسر حيث سكنت"
            },
            {
              "n": 42,
              "sadr": "إن لم تكن من قبل حرف استعلا",
              "ajuz": "أو كانت الكسرة ليست أصلا"
            },
            {
              "n": 43,
              "sadr": "والخلف في فرق لكسر يوجد",
              "ajuz": "وأخف تكريرًا إذا تشدد"
            }
          ]
        },
        {
          "heading": "باب اللامات",
          "lines": [
            {
              "n": 44,
              "sadr": "وفخِّم اللام من اسم الله",
              "ajuz": "عن فتح أو ضم كعبد الله"
            },
            {
              "n": 45,
              "sadr": "وحرف الاستعلاء فخم واخصصا",
              "ajuz": "لاطباق أقوى نحو قال والعصا"
            },
            {
              "n": 46,
              "sadr": "وبيِّن الإطباق من أَحَطْتُ مَع",
              "ajuz": "بَسَطْتَ والخلف بنخلقكم وقَع"
            },
            {
              "n": 47,
              "sadr": "واحرص على السكون في جعلنا",
              "ajuz": "أنعمتَ والمغضوبِ مع ضللنا"
            },
            {
              "n": 48,
              "sadr": "وخلص انفتاح محذورًا عسى",
              "ajuz": "خوف اشتباهه بمحظورًا عصى"
            },
            {
              "n": 49,
              "sadr": "وراعِ شدَّةً بكاف وبتا",
              "ajuz": "كشرككم وتتوفَّى فِتْنَتا"
            },
            {
              "n": 50,
              "sadr": "وأولى مثل وجنس إن سَكَن",
              "ajuz": "أدغم كقل رب وبل لا وأَبِنْ"
            },
            {
              "n": 51,
              "sadr": "في يوم معْ قالوا وهم وقل نعم",
              "ajuz": "سبِّحه لا تُزِغ قلوب فَالتَقَم"
            }
          ]
        },
        {
          "heading": "باب الضاد والظاء",
          "lines": [
            {
              "n": 52,
              "sadr": "والضاد باستطالة ومخرج",
              "ajuz": "ميِّز من الظاء وكلها تجي"
            },
            {
              "n": 53,
              "sadr": "في الظعن ظل الظهر عُظْم الحفظ",
              "ajuz": "أَيقِظ وأَنظُر عَظْم ظهر اللفظ"
            },
            {
              "n": 54,
              "sadr": "ظاهرْ لظى شُوَاظُ كَظْمٍ ظلما",
              "ajuz": "اُغلُظ ظلامَ ظفرٍ انتظر ظما"
            },
            {
              "n": 55,
              "sadr": "أظفرَ ظنًّا كيف جا وعظْ سوى",
              "ajuz": "عِضينَ ظل النحل زخرف سوى"
            },
            {
              "n": 56,
              "sadr": "وظلت ظَلْتم وبرُومٍ ظلُّوا",
              "ajuz": "كالحجرِ ظلَّت شُعَرَا نَظَلُّ"
            },
            {
              "n": 57,
              "sadr": "يَظْلَلن محظورًا مع المحتظر",
              "ajuz": "وكنتَ فظًّا وجميع النظر"
