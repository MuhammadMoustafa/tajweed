              "n": 76,
              "sadr": "فالتام فالكافي ولفظا فامنعَنْ",
              "ajuz": "إلا رؤوس الآي جوز فالحسَن"
            },
            {
              "n": 77,
              "sadr": "وغيرُ ما تمَّ قبيح وله",
              "ajuz": "ألوقف مضطرًّا ويُبْدَا قبله"
            },
            {
              "n": 78,
              "sadr": "وليس في القرآن من وقفٍ وجب",
              "ajuz": "ولا حرام غير ما له سبب"
