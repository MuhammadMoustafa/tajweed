            {
              "n": 103,
              "sadr": "ابنٍ مع ابنةٍ امرئٍ واثنينِ",
              "ajuz": "وامرأةٍ واسمٍ مع اثنتينِ"
            }
          ]
        },
        {
          "heading": "باب الوقف على أواخر الكلم",
          "lines": [
            {
              "n": 104,
              "sadr": "وحاذرِ الوقفَ بكل الحركه",
              "ajuz": "إلا إذا رُمْتَ فبعض حركه"
            },
