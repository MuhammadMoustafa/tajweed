            {
              "n": 67,
              "sadr": "وأدغمَنْ بغنة في يُومِنُ",
              "ajuz": "إلا بكلمةٍ كدنيا عَنْوَنُوا"
            },
            {
              "n": 68,
              "sadr": "والقلب عند البا بغنَّة كذا",
              "ajuz": "لاخفا لدى باقي الحروف أخذا"
            }
          ]
        },
        {
          "heading": "باب المد والقصر",
          "lines": [
            {
              "n": 69,
              "sadr": "والمد لازم وواجب أتى",
              "ajuz": "وجائز وهو وقصر ثبتا"
