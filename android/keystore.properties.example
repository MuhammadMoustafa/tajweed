# Release signing for `npm run release` (Gradle assembleRelease). Copy this file to
# android/keystore.properties (gitignored, never committed) and fill in your own values.
# Create the key once as described in CLAUDE.md, section Distribution. Use forward slashes in
# storeFile (a backslash is an escape character in .properties files). Back up the .jks: an
# APK signed with a different key cannot update an installed one.
storeFile=C:/Users/<you>/.android/tajweed-release.jks
storePassword=<store password>
keyAlias=tajweed
keyPassword=<key password>
